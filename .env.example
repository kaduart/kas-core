# Optional overrides for docker-compose.yml. Copy to .env (git-ignored) to change
# them. Every default below is a fictitious DEVELOPMENT value: never reuse it.
KAS_DEV_ADMIN_PASSWORD=kas_dev_admin_only
KAS_DEV_MIGRATOR_PASSWORD=kas_dev_migrator_only
KAS_DEV_RUNTIME_PASSWORD=kas_dev_runtime_only
# 64 hexadecimal characters each (32 bytes).
KAS_DEV_FONO_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
KAS_DEV_NODE_B_TOKEN=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# At least 32 characters.
KAS_DEV_METRICS_TOKEN=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
